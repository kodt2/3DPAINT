# Database Settings
DB_NAME=DB
DB_USER=USER
DB_PASSWORD=SECURE_DB_PASSWORD

# JWT Settings
JWT_SECRET=SECRET_KEY_AT_LEAST_32_CHARACRETS
JWT_ISSUER=MYAPP
JWT_AUDIENCE=MYAPPUSERS
# Clock skew (seconds) for JWT lifetime validation in the monolith, applied
# to BOTH the legacy HS256 and the Auth RS256 tokens (step 4.3a). Empty
# (default): 30. Lower it only if the clocks are known to be tight.
JWT_CLOCK_SKEW_SECONDS=

# ── Auth Service (step 4.1, ADR 0018) ─────────────────────────────────────────
# A standalone auth service (services/auth): its own PostgreSQL instance +
# user + database, SEPARATE from the monolith's DB_USER/DB_NAME above. The
# password is environment-only (never committed); the auth-initdb one-shot
# creates the `auth` user/database. RS256 signing keys live in the auth-keys
# volume (generated by the auth-keygen one-shot — never in the image or repo).
# The auth service has its OWN JWT identity (AUTH_JWT_ISSUER / AUTH_JWT_AUDIENCE),
# independent of the legacy monolith's JWT_ISSUER / JWT_AUDIENCE above — do not
# mix them. Internal only: no published port in ANY stack (the e2e stand
# reached it directly until step 4.3b, when the Gateway became the only
# route). The Gateway routes /api/auth/** and /api/me to it (step 4.3b).
AUTH_DB_PASSWORD=SECURE_AUTH_DB_PASSWORD
# Auth access-token lifetime in minutes (default 15).
AUTH_JWT_EXPIRY_MINUTES=15
# Optional access-token lifetime in SECONDS (test-only, step 4.3b): overrides
# AUTH_JWT_EXPIRY_MINUTES when set. Used by the e2e short-token stand
# (`make e2e-short`, 5 s tokens) to exercise the SPA refresh flow. Empty in
# normal operation — never set it in production.
AUTH_JWT_EXPIRY_SECONDS=
# RS256 issuer / audience the auth service signs (and validates) its access
# tokens with. Defaults are used if left empty.
AUTH_JWT_ISSUER=3dpaint.auth
AUTH_JWT_AUDIENCE=3dpaint
# Dev-only loopback port of the Auth OpenAPI document (infra/compose.override.yml),
# used by `npm run gen:api` (step 4.3a). Not a service setting: the Auth
# process itself does not read it. Dev stacks only; unused in production.
AUTH_DEV_PORT=18096
# Dev-only loopback port of the MONOLITH OpenAPI document (same file, same
# purpose): the Gateway has no /swagger route (3d.2), so gen:api fetches the
# monolith document through this port.
WEB_DEV_PORT=18097

# ── Monolith JWKS client (step 4.3a, ADR 0018) ────────────────────────────────
# The monolith validates the Auth service's RS256 tokens against its JWKS
# (lazy load, in-memory cache). Internal-only addresses: the monolith and
# Auth share the app network. If Auth is down, protected endpoints answer 401
# (not 500) and startup /api/health is unaffected.
# JWKS endpoint (internal network address; no published port involved).
MONOLITH_JWKS_URL=http://auth:8080/.well-known/jwks.json
# Refuse to start if MONOLITH_JWKS_URL is not https (production hardening).
# Dev default: false (http on the internal network is the design, ADR 0018).
MONOLITH_JWKS_REQUIRE_HTTPS=false
# An unknown key id (kid) triggers at most one JWKS refetch per this many
# seconds (rotation grace). Empty (default): 30.
MONOLITH_JWKS_REFRESH_THROTTLE_SECONDS=

# S3 storage settings (SeaweedFS in dev, ADR 0009)
# The app works with any S3-compatible storage: endpoint, region, keys and
# bucket are read from configuration only.
MINIO_ROOT_USER=MINIOADMIN
MINIO_ROOT_PASSWORD=SECURE_MINIO_PASSWORD
MINIO_BUCKET=userdata
# S3 region (leave empty if your storage does not require it)
MINIO_REGION=us-east-1

# Host port the gateway is published on (use 18080 on dev machines where 8080
# is busy). The gateway also uses it for the default allowed CSRF Origin:
# http://localhost:{WEB_PORT} (ADR 0011).
WEB_PORT=8080
# Monolith (web) environment: Development for local dev — this is the ONLY way
# to enable the OpenAPI document (/swagger) used by `npm run gen:api`.
# Production-like stacks must stay on Production (OpenAPI then answers 404).
ASPNETCORE_ENVIRONMENT=Development
# Comma-separated browser Origins allowed by the Gateway CSRF check for
# state-changing /api requests (ADR 0011). Empty = default
# http://localhost:{WEB_PORT}. Deploy: set the public domain, e.g.
# PUBLIC_ORIGIN=https://3dpaint.example.com (README, «Деплой на сервер»);
# the dev profile (make up-dev) adds http://localhost:5173 on its own.
PUBLIC_ORIGIN=
# Gateway rate limit for POST /api/auth/login and /api/auth/register
# (ADR 0011 §6.2): max requests per client per RATE_LIMIT_WINDOW_SECONDS
# seconds. Empty (default): 10 per 60. Raise for the test stand (repeated
# E2E runs), e.g. RATE_LIMIT_REQUESTS_PER_MINUTE=100; the production
# default is intentionally conservative.
RATE_LIMIT_REQUESTS_PER_MINUTE=
# Gateway rate limit for POST /api/auth/refresh (step 4.3b, ADR 0011 §6.2):
# separate, higher default (30 per 60) because the SPA fires refresh
# automatically on every access-token expiry. Same window as above.
RATE_LIMIT_REFRESH_REQUESTS_PER_MINUTE=
RATE_LIMIT_WINDOW_SECONDS=
# Trusted proxies for the rate-limit client key: X-Forwarded-For is honored
# only when the direct connection comes from one of these (comma-separated
# IPs / CIDRs). Empty (default): the client key is always the socket peer.
# On a server: set the reverse proxy's address (README, «Деплой на сервер»),
# otherwise all users share one bucket (the proxy's IP).
KNOWN_PROXIES=
KNOWN_NETWORKS=
# Public port for the S3 storage API (dev): the browser uploads/downloads files
# through presigned URLs that hit this endpoint directly (TD-3). Loopback only.
S3_PUBLIC_PORT=9000

# Filer UI port (SeaweedFS dev convenience, 127.0.0.1 only).
S3_FILER_PORT=8888
# Public S3 endpoint used to SIGN presigned URLs. Must be resolvable by the
# browser, and the Host in it must match the Host the browser actually requests
# (the signature covers it). In dev: http://localhost:<S3_PUBLIC_PORT>.
# On a server: a dedicated subdomain routed to S3 (see README, «Публичный S3»).
PUBLIC_S3_ENDPOINT=http://localhost:9000
# Comma-separated list of browser origins allowed to call S3 (CORS). The
# origin must match exactly what is typed in the browser address bar, so
# keep the app origins you actually use (localhost and 127.0.0.1 variants).
# SPA origins allowed to fetch presigned URLs from the browser (the viewer
# loads GLB files via JS fetch). Dev defaults: gateway (8080 / 18080), Vite
# (5173), e2e gateway (18090), each via localhost and 127.0.0.1. In
# production set this to the real SPA origin(s) only.
S3_CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:18080,http://127.0.0.1:18080,http://localhost:5173,http://127.0.0.1:5173,http://localhost:18090,http://127.0.0.1:18090
# Максимальный размер загружаемого файла в байтах (100 МБ по умолчанию).
# Единый лимит: читают и Gateway (Kestrel + YARP), и монолит (ADR 0015).
MAX_UPLOAD_BYTES=104857600
# Расширения для загрузки (через запятую), шаг 4.0. Единый источник: этот же
# список проверяет сервер (FileStorageService) и отдаёт /api/config, откуда его
# читает SPA — клиент и сервер не могут расходятся. По умолчанию .glb
# (вьювер SPA принимает только GLB).
ALLOWED_UPLOAD_EXTENSIONS=.glb

# ── HTTPS/LAN access (step H, ADR 0016) ────────────────────────────────────────
# The `https` profile (infra/compose.https.yml, make up-https) puts Caddy in
# front of the gateway and S3; ONLY Caddy's ports are published. Without the
# profile these variables are unused.
# Host address the Caddy ports are bound to: 127.0.0.1 (default, local only),
# the machine's LAN IP (e.g. 192.168.1.100) or 0.0.0.0 (all interfaces).
BIND_ADDR=127.0.0.1
# Caddy host ports (container ports are fixed: 80/443/9443). Keep them out of
# the way of WEB_PORT / S3_PUBLIC_PORT / the e2e stand.
HTTP_PORT=80
HTTPS_PORT=443
S3_HTTPS_PORT=9443
# TLS mode: lan (default) — Caddy internal CA, no HSTS (clients install the
# root cert once, README «Доступ по сети»); prod — Let's Encrypt, HSTS on
# (requires a public domain in PUBLIC_ORIGIN / PUBLIC_S3_ENDPOINT and Caddy
# reachable on :80/:443).
TLS_MODE=lan
# ACME contact, required for TLS_MODE=prod.
ACME_EMAIL=
# Host parts of PUBLIC_ORIGIN / PUBLIC_S3_ENDPOINT for the Caddy sites
# (entrypoint.sh). In lan mode with localhost ports these stay "localhost".
MAIN_HOST=localhost
S3_HOST=localhost
# NOTE: with the https profile the gateway's KNOWN_PROXIES is set by
# infra/compose.https.yml (Caddy's fixed address 172.28.0.10) — do not
# override it here unless you change that address (keep in sync).
# App-network subnet (step 4.0). The main stack keeps the 172.28.0.0/16
# default. The throwaway E2E/HTTPS stands (Makefile `e2e` / `e2e-https`) set a
# different /16 (172.29.0.0/16 / 172.30.0.0/16) via the command line so they
# can run alongside the main stack without a Docker network-pool overlap — no
# need to `make down` first. If you run a custom HTTPS stand, set
# APP_NETWORK_CADDY_IP to an address inside APP_NETWORK_SUBNET and keep it in
# sync with the gateway's KNOWN_PROXIES (compose.https.yml reads the same var).
APP_NETWORK_SUBNET=172.28.0.0/16
# Caddy's fixed address on the app-network (https profile). Must be an address
# inside APP_NETWORK_SUBNET; it is also the gateway's KNOWN_PROXIES (the only
# trusted proxy for X-Forwarded-For, ADR 0011 §6.2). The main HTTPS stand keeps
# 172.28.0.10; the e2e-https stand overrides it to 172.30.0.10 (see Makefile).
APP_NETWORK_CADDY_IP=172.28.0.10
