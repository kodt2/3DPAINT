# Database Settings
DB_NAME=DB
DB_USER=USER
DB_PASSWORD=SECURE_DB_PASSWORD

# JWT Settings
JWT_SECRET=SECRET_KEY_AT_LEAST_32_CHARACRETS
JWT_ISSUER=MYAPP
JWT_AUDIENCE=MYAPPUSERS

# S3 storage settings (SeaweedFS in dev, ADR 0009)
# The app works with any S3-compatible storage: endpoint, region, keys and
# bucket are read from configuration only.
MINIO_ROOT_USER=MINIOADMIN
MINIO_ROOT_PASSWORD=SECURE_MINIO_PASSWORD
MINIO_BUCKET=userdata
# S3 region (leave empty if your storage does not require it)
MINIO_REGION=us-east-1

# Host port the gateway is published on (use 18080 on dev machines where 8080
# is busy). The gateway also uses it for the default allowed CSRF Origin:
# http://localhost:{WEB_PORT} (ADR 0011).
WEB_PORT=8080
# Monolith (web) environment: Development for local dev — this is the ONLY way
# to enable the OpenAPI document (/swagger) used by `npm run gen:api`.
# Production-like stacks must stay on Production (OpenAPI then answers 404).
ASPNETCORE_ENVIRONMENT=Development
# Comma-separated browser Origins allowed by the Gateway CSRF check for
# state-changing /api requests (ADR 0011). Empty = default
# http://localhost:{WEB_PORT}. Deploy: set the public domain, e.g.
# PUBLIC_ORIGIN=https://3dpaint.example.com (README, «Деплой на сервер»);
# the dev profile (make up-dev) adds http://localhost:5173 on its own.
PUBLIC_ORIGIN=
# Gateway rate limit for POST /api/auth/login and /api/auth/register
# (ADR 0011 §6.2): max requests per client per RATE_LIMIT_WINDOW_SECONDS
# seconds. Empty (default): 10 per 60. Raise for the test stand (repeated
# E2E runs), e.g. RATE_LIMIT_REQUESTS_PER_MINUTE=100; the production
# default is intentionally conservative.
RATE_LIMIT_REQUESTS_PER_MINUTE=
RATE_LIMIT_WINDOW_SECONDS=
# Trusted proxies for the rate-limit client key: X-Forwarded-For is honored
# only when the direct connection comes from one of these (comma-separated
# IPs / CIDRs). Empty (default): the client key is always the socket peer.
# On a server: set the reverse proxy's address (README, «Деплой на сервер»),
# otherwise all users share one bucket (the proxy's IP).
KNOWN_PROXIES=
KNOWN_NETWORKS=
# Public port for the S3 storage API (dev): the browser uploads/downloads files
# through presigned URLs that hit this endpoint directly (TD-3). Loopback only.
S3_PUBLIC_PORT=9000

# Filer UI port (SeaweedFS dev convenience, 127.0.0.1 only).
S3_FILER_PORT=8888
# Public S3 endpoint used to SIGN presigned URLs. Must be resolvable by the
# browser, and the Host in it must match the Host the browser actually requests
# (the signature covers it). In dev: http://localhost:<S3_PUBLIC_PORT>.
# On a server: a dedicated subdomain routed to S3 (see README, «Публичный S3»).
PUBLIC_S3_ENDPOINT=http://localhost:9000
# Comma-separated list of browser origins allowed to call S3 (CORS). The
# origin must match exactly what is typed in the browser address bar, so
# keep the app origins you actually use (localhost and 127.0.0.1 variants).
# SPA origins allowed to fetch presigned URLs from the browser (the viewer
# loads GLB files via JS fetch). Dev defaults: gateway (8080 / 18080), Vite
# (5173), e2e gateway (18090), each via localhost and 127.0.0.1. In
# production set this to the real SPA origin(s) only.
S3_CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:18080,http://127.0.0.1:18080,http://localhost:5173,http://127.0.0.1:5173,http://localhost:18090,http://127.0.0.1:18090
# Максимальный размер загружаемого файла в байтах (решение 2026-11-22: 100 МБ;
# лимит тела запроса на Gateway/Kestrel)
MAX_UPLOAD_BYTES=104857600
