# Database Settings
DB_NAME=DB
DB_USER=USER
DB_PASSWORD=SECURE_DB_PASSWORD

# JWT Settings
JWT_SECRET=SECRET_KEY_AT_LEAST_32_CHARACRETS
JWT_ISSUER=MYAPP
JWT_AUDIENCE=MYAPPUSERS

# S3 storage settings (SeaweedFS in dev, ADR 0009)
# The app works with any S3-compatible storage: endpoint, region, keys and
# bucket are read from configuration only.
MINIO_ROOT_USER=MINIOADMIN
MINIO_ROOT_PASSWORD=SECURE_MINIO_PASSWORD
MINIO_BUCKET=userdata
# S3 region (leave empty if your storage does not require it)
MINIO_REGION=us-east-1

# Host port for the web service (use 18080 on dev machines where 8080 is busy)
WEB_PORT=8080
# Public port for the S3 storage API (dev): the browser uploads/downloads files
# through presigned URLs that hit this endpoint directly (TD-3). Loopback only.
S3_PUBLIC_PORT=9000
# Public S3 endpoint used to SIGN presigned URLs. Must be resolvable by the
# browser, and the Host in it must match the Host the browser actually requests
# (the signature covers it). In dev: http://localhost:<S3_PUBLIC_PORT>.
# On a server: a dedicated subdomain routed to S3 (see README, «Публичный S3»).
PUBLIC_S3_ENDPOINT=http://localhost:9000
# Comma-separated list of browser origins allowed to call S3 (CORS). Keep the
# app origins you actually use (both localhost and 127.0.0.1 by default, since
# the origin must match exactly what is typed in the browser address bar).
S3_CORS_ORIGINS=http://localhost:18080,http://127.0.0.1:18080
# Максимальный размер загружаемого файла в байтах (решение 2026-11-22: 100 МБ;
# лимит тела запроса на Gateway/Kestrel)
MAX_UPLOAD_BYTES=104857600
