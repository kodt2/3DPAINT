{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "AuthConnection": "Host=localhost;Port=5432;Database=auth;Username=auth;Password=auth"
  },
  "Jwt": {
    "Issuer": "3dpaint.auth",
    "Audience": "3dpaint",
    "ExpiryMinutes": 15,
    "CurrentKeyFile": "/keys/current.pem",
    "RsaKeySize": 2048
  },
  "RefreshToken": {
    "ExpiryDays": 30,
    "CookiePath": "/api/auth"
  },
  "Password": {
    "MinLength": 10
  },
  "AllowedHosts": "*"
}
