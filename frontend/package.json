{
    "name": "3dpaint-frontend",
    "private": true,
    "version": "0.1.0",
    "type": "module",
    "engines": {
        "node": ">=20.19"
    },
    "scripts": {
        "predev": "node scripts/sync-decoders.mjs",
        "dev": "vite",
        "prebuild": "node scripts/sync-decoders.mjs",
        "build": "tsc -b && vite build",
        "preview": "vite preview",
        "lint": "eslint .",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "test": "vitest run",
        "gen:api": "node scripts/gen-api.mjs",
        "gen:api:check": "node scripts/gen-api.mjs --check",
        "inspect:glb": "node scripts/inspect-glb.mjs",
        "test:e2e": "playwright test"
    },
    "dependencies": {
        "@react-three/drei": "^10.7.9",
        "@react-three/fiber": "^9.8.2",
        "@tanstack/react-query": "5.108.3",
        "openapi-fetch": "0.17.0",
        "react": "19.3.1",
        "react-dom": "19.3.1",
        "react-router": "7.18.6",
        "three": "^0.187.0"
    },
    "devDependencies": {
        "@eslint/js": "9.39.5",
        "@gltf-transform/core": "^4.5.1",
        "@gltf-transform/extensions": "^4.5.1",
        "@gltf-transform/functions": "^4.5.1",
        "@playwright/test": "^1.65.1",
        "@testing-library/jest-dom": "6.10.0",
        "@testing-library/react": "16.3.3",
        "@testing-library/user-event": "14.6.13",
        "@types/node": "22.20.5",
        "@types/react": "19.3.0",
        "@types/react-dom": "19.3.0",
        "@types/three": "^0.187.0",
        "@vitejs/plugin-react": "4.7.0",
        "draco3dgltf": "^1.5.9",
        "eslint": "9.39.5",
        "eslint-plugin-react-hooks": "7.1.1",
        "eslint-plugin-react-refresh": "0.5.8",
        "globals": "17.14.0",
        "jsdom": "31.0.1",
        "meshoptimizer": "^1.3.0",
        "openapi-typescript": "7.13.0",
        "prettier": "3.10.1",
        "typescript": "5.9.3",
        "typescript-eslint": "8.73.0",
        "vite": "7.3.8",
        "vitest": "3.2.7"
    }
}
